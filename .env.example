# Copy to .env.local and fill in. Never commit .env.local.
# -----------------------------------------------------------------------------
# Public (safe to expose to the browser)
# Optional. Defaults to the Vercel deployment URL, else http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase publishable key (sb_publishable_...) or legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Branding (optional; defaults live in src/lib/config/brand.ts)
NEXT_PUBLIC_BRAND_NAME=BarConnect

# -----------------------------------------------------------------------------
# Server-only. NOT used in Phase 1. Never prefix with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=

# Local database tests (plain Postgres; see docs/TESTING.md)
# TEST_DATABASE_URL=postgresql://root@localhost/barconnect_test?host=/var/run/postgresql
